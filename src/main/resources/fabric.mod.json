{
  "schemaVersion": 1,
  "id": "neko_client",
  "version": "${version}",
  "name": "Neko Client",
  "description": "虚空仓库客户端增强：① 搜索框（中文 / 拼音 / 注册名）；② Ctrl+Alt+右键 把一格物品取到背包放不下为止（常规模式纯散货、潜影盒模式满盒；组合键可在配置界面改，想用左键就绑 BUTTON_1）；③ 配方本浏览与删除（随地可用）。开关与热键由 malilib 提供（必需）。纯客户端模组，服务端需搭配 carpet-Neko-Addition 1.0.17+（配方本要 1.0.17+）。",
  "authors": [
    "Akirono"
  ],
  "license": "MIT",
  "icon": "assets/neko_client/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "neko.client.VoidWarehouseSearchClient"
    ],
    "modmenu": [
      "neko.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    "neko_client.mixins.json",
    "neko_client_litematica.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "1.20.1",
    "fabric-api": "*",
    "malilib": ">=0.16.3"
  },
  "suggests": {
    "carpet_neko_addition": "*"
  },
  "contributors": [
    "OvOSSK (Minecraft 1.20.1 Fabric port and maintenance)"
  ],
  "contact": {
    "sources": "https://github.com/OvOSSK/neko-voidwarehouse-search/tree/fabric-1.20.1"
  }
}
